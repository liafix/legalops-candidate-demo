{
  "name": "legalops-candidate-demo",
  "version": "1.3.0",
  "private": true,
  "description": "Independent synthetic-data IT operations and incident workflow candidate demonstrator.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:lock": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "release:check-lock": "node scripts/check-lockfile.mjs",
    "release:verify": "npm run release:check-lock && npm ci && npm run quality",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.14.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.24",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "prettier": "3.8.1",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
